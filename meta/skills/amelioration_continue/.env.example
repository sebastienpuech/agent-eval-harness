# Copier en .env (non commité). Bot Telegram dédié d'amelioration_continue.
# Token DÉDIÉ (créé via @BotFather), jamais un token déjà utilisé ailleurs : deux process qui
# pollent le même token se volent les updates -> 409 Conflict.
AMELIORE_BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Ton chat_id Telegram (whitelisté en dur ; le bot ignore tout autre chat).
AMELIORE_CHAT_ID=000000000
# Optionnel : nb de cas échantillonnés par passe (défaut 24). Plus haut = plus de retours captés, plus lent.
AMELIORE_SAMPLE=24
